<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <!-- 上部：日期+时间（68%） -->
    <LinearLayout
        android:id="@+id/layout_time"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="6.8"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="21dp"
        >

        <TextView
            android:id="@+id/tv_alarm_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="6月27日 周六"
            android:textColor="#C8A74A"
            android:textSize="21sp"
            android:textStyle="bold"
            
            android:shadowColor="#C8A74A"
            android:shadowDx="0"
            android:shadowDy="5"
            android:shadowRadius="6"/>

        <TextView
            android:id="@+id/tv_alarm_time"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="104sp"
            android:autoSizeMinTextSize="60sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:shadowColor="#A85542"
            android:shadowDx="0"
            android:shadowDy="10"

            android:shadowRadius="6"
            android:text="22:36"
            android:textColor="#D4AF37"
            android:textStyle="bold" />

        <!-- 保留给 Java -->
        

    </LinearLayout>

    <!-- 下部：按钮（32%） -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.2"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:paddingTop="0dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:layout_marginRight="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_snooze"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="延后"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:layout_marginLeft="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_alarm_stop"
            android:backgroundTint="@null"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:stateListAnimator="@null"
            android:text="停止"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
