<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/layout_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="42dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_alarm_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="星期一"
            android:textColor="#A98C3A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="23:58"
            android:textColor="#D4AF37"
            android:textSize="62sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_alarm_label"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_snooze"
            android:layout_width="0dp"
            android:layout_height="108dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:radius="18dp"
            android:backgroundTint="#A88C2C"
            android:text="延后"
            android:textAllCaps="false"
            android:textColor="#3A3A3A"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:elevation="16dp"
            android:shadowColor="#A98C3A"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="10" />

        <Button
            android:id="@+id/btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="108dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:radius="18dp"
            android:backgroundTint="#8A3C3C"
            android:text="停止"
            android:textAllCaps="false"
            android:textColor="#D8D8D8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:elevation="16dp"
            android:shadowColor="#8A3C3C"
            android:shadowDx="0"
            android:shadowDy="6"
            android:shadowRadius="10" />

    </LinearLayout>

</RelativeLayout>
