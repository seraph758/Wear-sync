<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 📸 拍照预览图层 -->
    <ImageView
        android:id="@+id/img_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="Preview" />

    <!-- ⚡ 文字提示层 -->
    <TextView
        android:id="@+id/tv_status_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#80000000"
        android:padding="12dp"
        android:text="正在拍照..."
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 🎯 聚焦框 -->
    <View
        android:id="@+id/focus_marker"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/focus_marker"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btn_shutter"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_shutter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="12dp"
        android:contentDescription="Take Photo" />

    <Button
        android:id="@+id/btn_switch_camera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_action_btn"
        android:text="🔄"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintCircle="@id/btn_shutter"
        app:layout_constraintCircleAngle="45"
        app:layout_constraintCircleRadius="65dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="#FFFFFF"
        android:textSize="60sp"
        android:textStyle="bold"
        android:visibility="gone"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

</androidx.constraintlayout.widget.ConstraintLayout>