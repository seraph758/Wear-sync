<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="#FFFFFF" />
            <size
                android:width="56dp"
                android:height="56dp" />
        </shape>
    </item>
    <!-- 内实心圆 -->
    <item
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
